/* base */
QWidget {
  background-color: #0b0b0f;          /* noir très foncé */
  color: #e8e7ef;
  font-family: "Segoe UI", Inter, Roboto, "Noto Sans", Arial;
  font-size: 13px;
}

/* boutons */
QPushButton {
  background: #6d28d9;                /* violet */
  border: 0;
  border-radius: 8px;
  padding: 6px 12px;
  color: white;
}
QPushButton:hover { background: #7c3aed; }
QPushButton:pressed { background: #5b21b6; }
QPushButton:disabled { background: #2a2440; color: #888; }

/* entrées texte */
QLineEdit, QSpinBox, QComboBox, QTextEdit, QPlainTextEdit {
  background: #12121a;
  border: 1px solid #26263a;
  border-radius: 8px;
  padding: 6px 8px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QTextEdit:focus, QPlainTextEdit:focus {
  border: 1px solid #7c3aed;
}

/* tables / listes */
QTreeView, QListView, QTableView {
  background: #0f0f16;
  alternate-background-color: #141420;
  border: 1px solid #23233a;
  border-radius: 8px;
}
QTreeView::item:selected, QListView::item:selected, QTableView::item:selected {
  background: #7c3aed; color: white;
}

/* onglets */
QTabBar::tab {
  background: #12121a;
  padding: 8px 14px;
  border: 1px solid #26263a;
  border-bottom: none;
  border-top-left-radius: 10px;
  border-top-right-radius: 10px;
  margin-right: 6px;
  color: #e8e7ef;
}
QTabBar::tab:selected { background: #1a1a25; border-color: #7c3aed; }

/* barres & menus */
QToolBar, QMenuBar {
  background: #0b0b0f;
  border-bottom: 1px solid #1d1d2a;
}
QMenu {
  background: #11111a;
  border: 1px solid #26263a;
  border-radius: 8px;
}
QMenu::item:selected { background: #7c3aed; }

/* liens & actions accent couleur */
QLabel[link="true"], a { color: #facc15; }   /* jaune */
